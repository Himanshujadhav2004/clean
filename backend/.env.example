# Cleanverse sandbox — get credentials from Cleanverse onboarding
CLEANVERSE_ENV=sandbox
CLEANVERSE_API_ID=your_api_id
CLEANVERSE_API_KEY=your_base64_api_key

# Monad Testnet — Chain ID 10143
RPC_URL=https://testnet-rpc.monad.xyz/
CHAIN=monad
ORG_ID=demo-org

# Monad aUSDC from POST /query_deposit_atoken_list { "chain": "monad" }
ATOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D

# Fill after: npm run deploy:monad (see contracts/deployments/monad-testnet.json)
PAYROLL_RUN_ADDRESS=
RECORD_KEEPER_ADDRESS=
VAULT_ADDRESS=

# Demo employer wallet — fund via https://faucet.monad.xyz
EMPLOYER_PRIVATE_KEY=

PORT=4000
